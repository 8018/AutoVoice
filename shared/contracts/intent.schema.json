{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autovoice/shared/intent.schema.json",
  "title": "CanonicalIntent",
  "$comment": "导航二轮协议：首次解析地点返回 domain=navigation、intent=choose_destination，slots.query 为原查询，slots.candidates 为 [{poiname,lat,lon,address?}] JSON 字符串；端侧只展示候选，不拉起地图。下一轮用户明确说序号或地点/地址名称后，服务端返回 intent=navigate，slots 携带 poiname/lat/lon，端侧才执行。多目的地 navigate 可加 waypoints string 槽，内容为 [{poiname,lat,lon}]。",
  "type": "object",
  "required": ["schemaVersion", "domain", "intent", "slots", "confidence"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "domain": { "type": "string" },
    "intent": { "type": "string" },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["number", "enum", "string", "boolean"] },
          "value": {},
          "unit": { "type": "string" }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string" },
    "rawSemantic": { "type": "string" }
  }
}
