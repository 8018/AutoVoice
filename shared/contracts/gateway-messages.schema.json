{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autovoice/shared/gateway-messages.schema.json",
  "title": "GatewayMessage",
  "description": "端云网关统一消息信封：{\"type\": \"...\", \"payload\": {...}}。type 决定 payload 形状（oneOf 分支）。各消息字段含义与示例以 shared/protocol.md 为准。additionalProperties 放开，不做过严校验。",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "enum": ["hello", "audio_start", "audio_end", "cancel_turn", "ready", "decision", "asr_partial", "reply_partial", "pending", "reply", "audio_reply_start", "audio_reply_end", "tts_request", "tts_response", "error", "bye"]
    }
  },
  "oneOf": [
    {
      "title": "hello (client -> server)",
      "properties": {
        "type": { "const": "hello" },
        "payload": {
          "type": "object",
          "required": ["client", "protocolVersion"],
          "properties": {
            "client": { "type": "string" },
            "protocolVersion": { "type": "string" },
            "sessionId": { "type": "string" },
            "deviceId": { "type": "string", "description": "设备标识（多设备加固 M5）：网关 auth-enabled 时必填，与 authToken 配对" },
            "authToken": { "type": "string", "description": "设备令牌（M5）：与服务器 AUTOVOICE_GATEWAY_AUTH_DEVICES 设备表匹配" }
          }
        }
      }
    },
    {
      "title": "audio_start (client -> server)",
      "properties": {
        "type": { "const": "audio_start" },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "sampleRate": { "type": "integer" },
            "channels": { "type": "integer" },
            "encoding": { "type": "string" },
            "segmentId": { "type": "string", "description": "客户端每轮生成的话语 ID，下行原样回显" },
            "utteranceId": { "type": "string", "description": "链路追踪：端侧每轮生成的 UUID，随 audio_start 上传，服务端插桩复用（可选，向后兼容）" },
            "latitude": { "type": "number", "minimum": -90, "maximum": 90, "description": "当前车辆纬度（可选），用于周边 POI 检索" },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180, "description": "当前车辆经度（可选），用于周边 POI 检索" }
          }
        }
      }
    },
    {
      "title": "audio_end (client -> server)",
      "properties": {
        "type": { "const": "audio_end" },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "durationMs": { "type": "integer" }
          }
        }
      }
    },
    {
      "title": "cancel_turn (client -> server)",
      "properties": {
        "type": { "const": "cancel_turn" },
        "payload": {
          "type": "object",
          "required": ["segmentId"],
          "properties": {
            "segmentId": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    {
      "title": "ready (server -> client)",
      "properties": {
        "type": { "const": "ready" },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "language": { "type": "string" },
            "protocolVersion": { "type": "string" },
            "serverTime": { "type": "integer", "description": "服务端墙钟毫秒，客户端估算时钟偏移用（可选）" }
          }
        }
      }
    },
    {
      "title": "decision (server -> client, 决策日志事件)",
      "properties": {
        "type": { "const": "decision" },
        "payload": {
          "type": "object",
          "properties": {
            "arbiter": { "type": "string", "enum": ["on-device", "cloud"] },
            "route": { "type": "string", "enum": ["local", "cloud", "nlu-traditional", "llm"] },
            "reason": { "type": "string" },
            "utteranceId": { "type": "string" },
            "timestampMs": { "type": "integer" }
          }
        }
      }
    },
    {
      "title": "asr_partial (server -> client, 云端 ASR 中间结果)",
      "properties": {
        "type": { "const": "asr_partial" },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "segmentId": { "type": "string" },
            "text": { "type": "string" },
            "isFinal": { "type": "boolean" }
          }
        }
      }
    },
    {
      "title": "reply_partial (server -> client, 模型回答文本增量)",
      "properties": {
        "type": { "const": "reply_partial" },
        "payload": {
          "type": "object",
          "required": ["segmentId", "text", "isFinal"],
          "properties": {
            "segmentId": { "type": "string" },
            "text": { "type": "string", "description": "截至当前的累计回答文本" },
            "isFinal": { "type": "boolean" }
          }
        }
      }
    },
    {
      "title": "pending (server -> client, LLM 处理中占位)",
      "properties": {
        "type": { "const": "pending" },
        "payload": {
          "type": "object",
          "properties": {
            "segmentId": { "type": "string", "description": "回显 audio_start 的 segmentId(§3.2),端侧据此对账当前话语" },
            "text": { "type": "string", "description": "处理中文案(可选,端侧可忽略固定文案)" }
          }
        }
      }
    },
    {
      "title": "reply (server -> client)",
      "properties": {
        "type": { "const": "reply" },
        "payload": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["text", "audio", "action"] },
            "speakText": { "type": "string" },
            "text": { "type": "string" }
          },
          "oneOf": [
            {
              "title": "reply/text",
              "properties": {
                "kind": { "const": "text" }
              }
            },
            {
              "title": "reply/audio",
              "properties": {
                "kind": { "const": "audio" },
                "mime": { "type": "string" },
                "dataBase64": { "type": "string" },
                "intent": {
                  "type": "object",
                  "required": ["schemaVersion", "domain", "intent", "slots", "confidence"],
                  "properties": {
                    "schemaVersion": { "type": "string", "const": "1.0" },
                    "domain": { "type": "string" },
                    "intent": { "type": "string" },
                    "slots": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "required": ["type", "value"],
                        "properties": {
                          "type": { "enum": ["number", "enum", "string", "boolean"] },
                          "value": {},
                          "unit": { "type": "string" }
                        }
                      }
                    },
                    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                    "source": { "type": "string" },
                    "rawSemantic": { "type": "string" }
                  }
                }
              },
              "required": ["kind", "mime", "dataBase64"]
            },
            {
              "title": "reply/action",
              "properties": {
                "kind": { "const": "action" },
                "intent": {
                  "type": "object",
                  "required": ["schemaVersion", "domain", "intent", "slots", "confidence"],
                  "properties": {
                    "schemaVersion": { "type": "string", "const": "1.0" },
                    "domain": { "type": "string" },
                    "intent": { "type": "string" },
                    "slots": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "required": ["type", "value"],
                        "properties": {
                          "type": { "enum": ["number", "enum", "string", "boolean"] },
                          "value": {},
                          "unit": { "type": "string" }
                        }
                      }
                    },
                    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                    "source": { "type": "string" },
                    "rawSemantic": { "type": "string" }
                  }
                },
                "speakText": { "type": "string" }
              },
              "required": ["kind", "intent", "speakText"]
            }
          ]
        }
      }
    },
    {
      "title": "audio_reply_start (server -> client, S2S PCM 流开始)",
      "properties": {
        "type": { "const": "audio_reply_start" },
        "payload": {
          "type": "object",
          "required": ["segmentId", "mime", "sampleRate", "channels", "encoding"],
          "properties": {
            "segmentId": { "type": "string" },
            "mime": { "type": "string", "const": "audio/pcm" },
            "sampleRate": { "type": "integer", "minimum": 1 },
            "channels": { "type": "integer", "minimum": 1 },
            "encoding": { "type": "string", "const": "pcm_s16le" }
          }
        }
      }
    },
    {
      "title": "audio_reply_end (server -> client, S2S PCM 流结束)",
      "properties": {
        "type": { "const": "audio_reply_end" },
        "payload": {
          "type": "object",
          "required": ["segmentId"],
          "properties": {
            "segmentId": { "type": "string" },
            "speakText": { "type": "string" },
            "asrText": { "type": "string", "description": "用户输入语音的最终识别文本" },
            "intent": { "$ref": "intent.schema.json" }
          }
        }
      }
    },
    {
      "title": "tts_request (client -> server, TTS 解耦 v1.1)",
      "properties": {
        "type": { "const": "tts_request" },
        "payload": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "segmentId": { "type": "string" },
            "utteranceId": { "type": "string", "description": "随 tts_request 上传，tts-server 插桩用" }
          }
        }
      }
    },
    {
      "title": "tts_response (server -> client, TTS 合成结果)",
      "properties": {
        "type": { "const": "tts_response" },
        "payload": {
          "type": "object",
          "required": ["mime", "dataBase64"],
          "properties": {
            "mime": { "type": "string" },
            "dataBase64": { "type": "string" },
            "text": { "type": "string" },
            "segmentId": { "type": "string" }
          }
        }
      }
    },
    {
      "title": "error (server -> client)",
      "properties": {
        "type": { "const": "error" },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    },
    {
      "title": "bye (server -> client)",
      "properties": {
        "type": { "const": "bye" },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      }
    }
  ]
}
