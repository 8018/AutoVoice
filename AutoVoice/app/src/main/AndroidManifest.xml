<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 录音（Task 19 运行时申请）；INTERNET 给 Task 20 的网关 WebSocket 用，现在无害 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络可用性检查（Task 20 engine 的 ConnectivityManager 判定） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 讯飞离线命令词 workDir=/sdcard/iflytek/（Task 34）：AIKit 运行时直写外部存储，
         targetSdk 34 需 MANAGE_EXTERNAL_STORAGE（adb appops 或系统设置"所有文件访问"授予）；
         ≤32 用经典读写权限 + legacy 豁免（与讯飞 demo targetSdk 30 配置对齐） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 媒体访问（对齐讯飞离线命令词 demo：Android 13+ READ_EXTERNAL_STORAGE 拆分为
         READ_MEDIA_*，demo 的 XXPermissions 申请照片+视频，这里等价声明 + 运行时请求） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- usesCleartextTraffic：网关走明文 ws://（局域网/部署机，Task 51 真机验收修复）——
         Android 9+ 默认禁 cleartext，okhttp 在 TCP 前即拒绝，manifest 必须显式放行 -->
    <application
        android:label="AutoVoice"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
