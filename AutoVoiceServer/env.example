# AutoVoice 云端服务环境变量模板（复制为 .env 或按部署方式注入）。
# 真实值只填在服务器上，本仓库绝不提交任何 secret 字面值。
# 服务器实际部署模板见 deploy/env.example（含 systemd 说明）。

# ---- 密钥（8 个，provider 调用时才读取；缺省为空 = 对应链路调用时失败）----
XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
DEEPSEEK_API_KEY=
ALIYUN_AK=
ALIYUN_SK=
ALIYUN_NLS_APPKEY=
DASHSCOPE_API_KEY=

# ---- 离线命令词链路（可选，默认关）----
# 置 true 时服务端启用讯飞离线命令词识别（仅 Linux x86-64，需部署 SDK 与 JNI 桥，
# 见 deploy/README.md）。凭据复用 XFYUN_APPID/API_KEY/API_SECRET（联网激活）。
# AUTOVOICE_OFFLINE_ENABLED=true
# AUTOVOICE_OFFLINE_LICENSE_FILE=/opt/autovoice/iflytek-offline/license

# ---- TTS 播报缓存（可选）----
# 非空时开启磁盘缓存（cache HIT 秒回）；空 → 仅内存缓存。
# AUTOVOICE_TTS_CACHE_DIR=/opt/autovoice/tts-cache
