# AutoVoice 云端服务环境变量模板（复制为 .env 或按部署方式注入）。
# 真实值只填在服务器上，本仓库绝不提交任何 secret 字面值。
# 服务器实际部署模板见 deploy/env.example（含 systemd 说明）。

# ---- 密钥（8 个，provider 调用时才读取；缺省为空 = 对应链路调用时失败）----
XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
DEEPSEEK_API_KEY=
ALIYUN_AK=
ALIYUN_SK=
ALIYUN_NLS_APPKEY=
DASHSCOPE_API_KEY=
# 可选：配置后使用业务空间专属域名；留空时使用北京地域通用实时地址。
DASHSCOPE_WORKSPACE_ID=

# ---- 离线命令词链路（可选，默认关）----
# 置 true 时服务端启用讯飞离线命令词识别（仅 Linux x86-64，需部署 SDK 与 JNI 桥，
# 见 deploy/README.md）。凭据复用 XFYUN_APPID/API_KEY/API_SECRET（联网激活）。
# AUTOVOICE_OFFLINE_ENABLED=true
# AUTOVOICE_OFFLINE_LICENSE_FILE=/opt/autovoice/iflytek-offline/license

# ---- TTS 播报缓存（可选）----
# 非空时开启磁盘缓存（cache HIT 秒回）；空 → 仅内存缓存。
# AUTOVOICE_TTS_CACHE_DIR=/opt/autovoice/tts-cache

# ---- 生产 profile 必需项（production profile 由 ProductionConfigGuard fail-closed 校验，
#      缺任一即拒绝启动；demo-full profile 不校验）----
# 设备鉴权开关 + 设备表 {deviceId: token}（JSON 字符串）
# AUTOVOICE_GATEWAY_AUTH_ENABLED=true
# AUTOVOICE_GATEWAY_AUTH_DEVICES='{"demo-1":"<token>"}'
# 遥测采集/查询边界令牌
# AUTOVOICE_TELEMETRY_ACCESS_TOKEN=<random-secret>
# 遥测查询(管理员)令牌:与设备上传 access-token 分权(D03a),生产 profile 必需
# AUTOVOICE_TELEMETRY_ADMIN_TOKEN=<random-secret>

# ---- 技能管理(D03b 管理会话,可选)----
# 管理会话 TTL(默认 12h)与 cookie Secure 标志(HTTPS 部署置 true)
# SKILL_MANAGER_ADMIN_SESSION_TTL_MS=43200000
# SKILL_MANAGER_COOKIE_SECURE=true

# ---- 接入配额(D10a,可选)----
# 每设备并发连接上限(默认 4)与握手截止毫秒(默认 10000;超时关闭未 hello 的连接)
# AUTOVOICE_GATEWAY_MAX_CONNECTIONS_PER_DEVICE=4
# AUTOVOICE_GATEWAY_HELLO_DEADLINE_MS=10000

# ---- 排空与健康探测(D12a,可选)----
# 排空期限:停止接入后等待在途工作的上限(默认 30000ms)
# AUTOVOICE_GATEWAY_DRAIN_TIMEOUT_MS=30000
# 健康端点:GET /health/live(存活)、GET /health/ready(就绪,503=不可接管流量)、
#          POST /health/drain(进入排空,供发布切换)

# ---- 原始音频治理(D14b,生产默认不持久化)----
# 全局开关:生产保持 false;临时诊断用 POST /api/telemetry/audio/diagnostic(管理令牌,按设备限时)
# AUTOVOICE_TELEMETRY_AUDIO_PERSIST=false
# 音频目录容量上限(字节,默认 1GB);超限丢弃新音频并记 warn,不阻断识别
# AUTOVOICE_TELEMETRY_AUDIO_MAX_BYTES=1073741824

# ---- MCP 凭据引用(D14a)----
# 平台侧 authValue 填引用而非明文:env:NAME(推荐)或 file:/path(0600)
# AMAP_MCP_KEY=<在此注入,不入库>
