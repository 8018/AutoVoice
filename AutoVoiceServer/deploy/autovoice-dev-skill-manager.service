[Unit]
Description=AutoVoice Skill Manager (dev)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/autovoice-dev/.env
WorkingDirectory=/opt/autovoice-dev
ExecStart=/usr/bin/java -jar /opt/autovoice-dev/skill-manager/skill-manager.jar
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
