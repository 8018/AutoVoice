[Unit]
Description=AutoVoice Gateway Server (dev, demo-full)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/autovoice-dev/.env
WorkingDirectory=/opt/autovoice-dev
ExecStart=/usr/bin/java -jar /opt/autovoice-dev/app.jar --spring.profiles.active=demo-full
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
