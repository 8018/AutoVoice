# AutoVoice dev 部署栈环境变量模板（服务器 /etc/autovoice-dev/.env）。
# 密钥与生产相同（同一台机器、同一批 provider），直接从 /etc/autovoice/.env 复制即可。
# 本文件只含模板，真实值只填在服务器上。

# ---- 密钥（从生产 .env 复制）----
XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
DEEPSEEK_API_KEY=
ALIYUN_AK=
ALIYUN_SK=
ALIYUN_NLS_APPKEY=
DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=

# ---- dev 栈端口与内部路由（默认值与 systemd unit 一致，无特殊情况不用改）----
# 网关监听端口（安全组放行入方向 8090 供手机测试）
AUTOVOICE_PORT=8090
# 网关转发 TTS 到 dev TTS 服务
AUTOVOICE_TTS_REMOTE_URL=http://127.0.0.1:8092/tts
# dev TTS 服务端口
TTS_PORT=8092
# dev 技能管理服务端口
SKILL_MANAGER_PORT=8093
# 技能管理 SQLite（独立于生产）
SKILL_MANAGER_DB=/opt/autovoice-dev/skill-manager/skill-manager.db
# 技能变更回调 dev 网关（路径与生产一致，仅端口不同；如生产未配置则保持空）
# SKILL_MANAGER_GATEWAY_WEBHOOK_URL=http://127.0.0.1:8090

# ---- 独立状态目录（与生产隔离，勿删注释中的说明）----
# 遥测 SQLite 落盘位置（网关内嵌遥测）
AUTOVOICE_TELEMETRY_DB_PATH=/opt/autovoice-dev/telemetry.db
# TTS 磁盘缓存
AUTOVOICE_TTS_CACHE_DIR=/opt/autovoice-dev/tts-cache

# ---- 离线命令词链路（可选，默认关）----
# 置 true 时 dev 网关启用离线命令词。只读资源共享生产路径，work 目录独立：
#   AUTOVOICE_OFFLINE_LIB_PATH（默认 /opt/autovoice/iflytek-offline/libautovoice_offline_esr.so）
#   AUTOVOICE_OFFLINE_RESOURCE_DIR（默认 /opt/autovoice/iflytek-offline/resource）
#   AUTOVOICE_OFFLINE_FSA_PATH（默认 /opt/autovoice/iflytek-offline/cn_fsa.txt）
#   AUTOVOICE_OFFLINE_WORK_DIR 必须独立（默认 /opt/autovoice-dev/iflytek-offline/work）
# AUTOVOICE_OFFLINE_ENABLED=true
# AUTOVOICE_OFFLINE_WORK_DIR=/opt/autovoice-dev/iflytek-offline/work

# ---- 鉴权（与生产一致）----
# AUTOVOICE_GATEWAY_AUTH_ENABLED=true
# AUTOVOICE_GATEWAY_AUTH_DEVICES='{"demo-1":"..."}'
