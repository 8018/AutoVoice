XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
DEEPSEEK_API_KEY=
ALIYUN_AK=
ALIYUN_SK=
ALIYUN_NLS_APPKEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=

# 离线命令词链路开关（需先按 deploy/README.md 部署 SDK + JNI 桥）
# AUTOVOICE_OFFLINE_ENABLED=true
# 离线授权（可选；不设走联网激活，凭据用上面的 XFYUN_*）
# AUTOVOICE_OFFLINE_LICENSE_FILE=/opt/autovoice/iflytek-offline/license

# TTS 磁盘缓存（可选；不设仅内存缓存）
# AUTOVOICE_TTS_CACHE_DIR=/opt/autovoice/tts-cache
